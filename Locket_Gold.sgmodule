#!url=https://cdn.jsdelivr.net/gh/nguyenquocc116-ship-it/ByGold@refs/heads/main/Locket_Gold.sgmodule
#!name=Locket_Gold

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://cdn.jsdelivr.net/gh/nguyenquocc116-ship-it/ByGold@refs/heads/main/Locket_1.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://cdn.jsdelivr.net/gh/nguyenquocc116-ship-it/ByGold@refs/heads/main/js/deleteHeader.js, timeout=60

locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://cdn.jsdelivr.net/gh/nguyenquocc116-ship-it/ByGold@refs/heads/main/Locket_Unlocked_formatted.json, requires-body=true, max-size=-1, timeout=60

locket_unlocked = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/setClientData, requires-body=1, max-size=0, script-path=https://cdn.jsdelivr.net/gh/nguyenquocc116-ship-it/ByGold@refs/heads/main/Locket_rc_us.js, timeout=10

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
